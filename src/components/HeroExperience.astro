---
const days = ["Mon", "Tue", "Wed", "Thu", "Fri"];
const hours = ["9 AM", "10 AM", "11 AM", "12 PM", "1 PM", "2 PM", "3 PM", "4 PM"];
const appointments = [
  { day: 0, slot: 0, blocks: 1, name: "Botox consult" },
  { day: 0, slot: 3, blocks: 2, name: "Skin consult" },
  { day: 0, slot: 6, blocks: 1, name: "HydraFacial" },
  { day: 1, slot: 1, blocks: 1, name: "HydraFacial" },
  { day: 1, slot: 4, blocks: 1, name: "Follow-up" },
  { day: 1, slot: 6, blocks: 2, name: "Microneedling" },
  { day: 2, slot: 0, blocks: 2, name: "Wellness consult" },
  { day: 2, slot: 3, blocks: 1, name: "Skin consult" },
  { day: 2, slot: 5, blocks: 1, name: "Lip filler" },
  { day: 3, slot: 0, blocks: 1, name: "New consult" },
  { day: 3, slot: 2, blocks: 1, name: "Dysport" },
  { day: 3, slot: 5, blocks: 1, name: "Botox consult", featured: true },
  { day: 3, slot: 7, blocks: 1, name: "Skin follow-up" },
  { day: 4, slot: 0, blocks: 1, name: "HydraFacial" },
  { day: 4, slot: 3, blocks: 2, name: "New consult" },
  { day: 4, slot: 6, blocks: 1, name: "Botox consult" },
];
---
<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="container hero-layout">
    <div class="hero-copy">
      <p class="hero-audience">Built for aesthetic &amp; wellness clinics.</p>
      <h1 class="display" id="home-hero-title">Better patient acquisition.<br /><mark>Fewer missed opportunities.</mark></h1>
      <p class="hero-lead">
        From the first search to the booked appointment, we make marketing and patient follow-up work together. Built for med spas and cash-pay clinics.
      </p>
      <div class="btn-row hero-actions">
        <a href="/book/" class="btn">Schedule My Call</a>
        <a href="/how-it-works/" class="btn btn--outline-light">See how we work</a>
      </div>
    </div>

    <div class="hero-demo" role="img" aria-label="Illustrative clinic calendar with appointments being added, and a steadily rising revenue trend chart. These are demonstration graphics, not actual client results.">
      <div class="calendar-card" aria-hidden="true">
        <div class="calendar-head">
          <span class="calendar-title">This week</span>
          <span class="calendar-caption">Front desk calendar</span>
        </div>
        <div class="day-labels">
          <span aria-hidden="true"></span>
          {days.map((day) => <span>{day}</span>)}
        </div>
        <div class="schedule">
          <div class="time-labels">
            {hours.map((hour) => <span>{hour}</span>)}
          </div>
          <div class="day-grid">
            {days.map((day, dayIndex) => (
              <div class="day-column">
                {appointments.filter((item) => item.day === dayIndex).map((item, itemIndex) => (
                  <div
                    class:list={["appointment", { "appointment--featured": item.featured }]}
                    style={`--appt-top:${item.slot * 44 + 4}px;--appt-height:${item.blocks * 44 - 8}px;--mobile-top:${item.slot * 35.75 + 3}px;--mobile-height:${item.blocks * 35.75 - 6}px;--appt-delay:${400 + (dayIndex * 3 + itemIndex) * 85}ms`}
                  >
                    <span>{item.name}</span>
                    {item.featured && <span class="appointment-check" aria-hidden="true">✓</span>}
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="lead-note floating-chip" aria-hidden="true">
        <span class="chip-icon chip-icon--lead">◎</span>
        <div><strong>New inquiry</strong><span>Botox consult · Meta</span></div>
      </div>
      <div class="booked-note floating-chip" aria-hidden="true">
        <span class="chip-icon chip-icon--booked">✓</span>
        <div><strong>Appointment booked</strong><span>Thursday · 2 PM</span></div>
      </div>
      <div class="revenue-card" aria-hidden="true">
        <div class="revenue-head">
          <div><span class="revenue-eyebrow">The bigger picture</span><strong>Revenue trend</strong></div>
          <span class="trend-symbol">↗</span>
        </div>
        <svg class="revenue-chart" viewBox="0 0 260 94" preserveAspectRatio="none" focusable="false" aria-hidden="true">
          <defs>
            <linearGradient id="hero-chart-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1D6FE0" stop-opacity=".20"/>
              <stop offset="100%" stop-color="#1D6FE0" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <path d="M0 77 L42 72 L83 62 L125 66 L163 46 L207 42 L260 12 L260 94 L0 94 Z" fill="url(#hero-chart-fill)"/>
          <path class="revenue-path" d="M0 77 L42 72 L83 62 L125 66 L163 46 L207 42 L260 12" fill="none" stroke="#1D6FE0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <circle class="revenue-dot" cx="260" cy="12" r="5" fill="#1D6FE0" stroke="white" stroke-width="3"/>
        </svg>
        <div class="revenue-axis"><span>Earlier</span><span>Later</span></div>
      </div>
      <p class="demo-disclaimer">Illustrative schedule and trend — not client performance data.</p>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 88% at 86% 3%, rgba(29,111,224,.34), transparent 72%),
      radial-gradient(ellipse 62% 75% at 0% 100%, rgba(29,111,224,.16), transparent 72%),
      #0b1220;
    color: #fff;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    padding-block: clamp(3.5rem, 6vw, 6.5rem) clamp(4.5rem, 6vw, 7rem);
  }
  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.04fr);
    align-items: center;
    gap: clamp(2rem, 3vw, 4.5rem);
    min-height: 610px;
  }
  .hero-copy { position: relative; z-index: 3; max-width: 600px; }
  .hero-audience {
    color: #bdcce1;
    font: 500 1.05rem/1.4 var(--font-body);
    letter-spacing: 0;
    margin-bottom: 1.45rem;
  }
  /* Exact display family/weight/leading from the supplied Claude reference: Switzer Semibold. */
  .hero-copy .display { font-family: "Switzer", "Inter", ui-sans-serif, system-ui, sans-serif; font-weight: 600; font-size: clamp(3.15rem, 4.7vw, 4.25rem); line-height: 1.06; letter-spacing: -.03em; }
  .hero-copy mark { --hl: rgba(29,111,224,.56); }
  .hero-lead { color: #b1bed1; font-size: clamp(1.1rem, 1.45vw, 1.26rem); line-height: 1.52; margin-top: 1.8rem; max-width: 540px; }
  .hero-actions { margin-top: 2rem; }
  .hero-actions .btn { font-family: "Inter", ui-sans-serif, system-ui, sans-serif; font-size: 1rem; font-weight: 700; letter-spacing: .03em; }
  .hero-demo { position: relative; width: 100%; max-width: 625px; height: 608px; margin-inline: auto; }
  .calendar-card {
    position: absolute;
    top: 45px;
    right: 0;
    width: min(100%, 555px);
    background: #fff;
    border: 1px solid #e4ebf6;
    border-radius: 14px;
    box-shadow: 0 30px 75px rgba(0,0,0,.36);
    color: #0b1220;
    padding: 1.15rem 1.15rem 1.4rem;
    animation: calendar-in 850ms cubic-bezier(.2,.8,.2,1) both, slow-float 8s ease-in-out 1s infinite;
  }
  .calendar-head { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:0 .15rem 1.15rem; }
  .calendar-title { font: 600 1.375rem/1.1 "Switzer", "Inter", ui-sans-serif, system-ui, sans-serif; letter-spacing:-.02em; }
  .calendar-caption { font: 500 .75rem/1.4 var(--font-body); color:#66748b; }
  .day-labels { display:grid; grid-template-columns: 47px repeat(5, minmax(0,1fr)); padding-bottom:.55rem; }
  .day-labels span { text-align:center; font:700 .73rem/1.4 var(--font-body); }
  .schedule { display:flex; height:352px; }
  .time-labels { display:flex; flex-direction:column; width:47px; flex:none; color:#778399; }
  .time-labels span { height:44px; flex:none; font:500 .63rem/1 var(--font-body); padding-top:5px; white-space:nowrap; }
  .day-grid { flex:1; min-width:0; display:grid; grid-template-columns:repeat(5, minmax(0,1fr)); border-top:1px solid #dce3ee; border-left:1px solid #edf1f6; }
  .day-column {
    position:relative;
    min-width:0;
    border-right:1px solid #eef1f6;
    background:repeating-linear-gradient(to bottom, transparent 0, transparent 43px, #dce3ee 43px, #dce3ee 44px);
  }
  .appointment {
    position:absolute;
    top:var(--appt-top); height:var(--appt-height);
    left:3px; right:3px; overflow:visible;
    border-radius:5px; padding:5px 5px;
    background:#1d6fe0; color:#fff;
    font:600 clamp(.56rem,.8vw,.72rem)/1.16 var(--font-body);
    overflow-wrap:anywhere;
    box-shadow:0 3px 8px rgba(20,79,169,.10);
    animation: appointment-in 680ms cubic-bezier(.16,1,.3,1) var(--appt-delay) both;
  }
  .appointment--featured { color:#1556ac; background:#fff; border:2px solid #1d6fe0; box-shadow:0 8px 15px rgba(29,111,224,.17); padding:3px; overflow:visible; }
  .appointment-check {
    position:absolute; top:-10px; right:-8px;
    display:grid; place-items:center; width:20px; height:20px; border-radius:50%;
    color:white; background:#1d6fe0; border:2px solid #fff; font:700 11px/1 var(--font-body);
  }
  .floating-chip {
    position:absolute; z-index:2;
    display:flex; align-items:center; gap:.75rem;
    padding:.8rem 1rem;
    background:#fff; color:#0b1220;
    border-radius:10px;
    box-shadow:0 15px 45px rgba(0,0,0,.26);
    animation: chip-in 680ms ease-out 900ms both, chip-hover 6s ease-in-out 1.7s infinite;
  }
  .floating-chip strong { display:block; font:700 .97rem/1.35 var(--font-body); white-space:nowrap; }
  .floating-chip div span { display:block; color:#68758b; font:.75rem/1.4 var(--font-body); white-space:nowrap; }
  .chip-icon { display:grid; place-items:center; width:36px; height:36px; flex:none; border-radius:50%; font:700 1.3rem/1 var(--font-body); }
  .chip-icon--lead { color:#1d6fe0; background:#eaf2fe; }
  .chip-icon--booked { color:#fff; background:#1d6fe0; }
  .lead-note { top:0; left:-22px; }
  .booked-note { right:-15px; bottom:49px; animation-delay: 1.9s, 2.6s; }
  .revenue-card {
    position:absolute; left:-15px; bottom:6px; z-index:2;
    width: min(295px,62%); background:#fff; color:#0b1220;
    border:1px solid #e6eaf1; border-radius:12px; padding:1rem 1.15rem .85rem;
    box-shadow:0 20px 50px rgba(0,0,0,.29);
    animation: chip-in 850ms ease-out 1.4s both;
  }
  .revenue-head { display:flex; align-items:center; justify-content:space-between; }
  .revenue-eyebrow { display:block; font:600 .65rem/1.5 var(--font-body); text-transform:uppercase; letter-spacing:.1em; color:#7b889b; }
  .revenue-head strong { display:block; font:600 1.07rem/1.3 "Switzer", "Inter", ui-sans-serif, system-ui, sans-serif; letter-spacing:-.025em; }
  .trend-symbol { display:grid; place-items:center; color:#1764cc; background:#eaf2fe; width:30px; height:30px; border-radius:50%; font-size:1.2rem; }
  .revenue-chart { display:block; width:100%; height:75px; overflow:visible; margin-top:.3rem; }
  .revenue-path { stroke-dasharray:340; stroke-dashoffset:340; animation: draw-line 3s ease-out 1.8s forwards; }
  .revenue-dot { animation: dot-in 350ms ease-out 4.8s both; }
  .revenue-axis { display:flex; justify-content:space-between; font:500 .65rem/1 var(--font-body); color:#9ba5b6; }
  .demo-disclaimer { position:absolute; bottom:-26px; right:0; color:#8491a7; font:400 .64rem/1.4 var(--font-body); text-align:right; }
  @keyframes calendar-in { from { opacity:0; transform:translateY(18px) scale(.98); } to { opacity:1; transform:translateY(0) scale(1); } }
  @keyframes slow-float { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-5px); } }
  @keyframes appointment-in { from { opacity:0; transform:translateY(9px) scale(.97); } to { opacity:1; transform:translateY(0) scale(1); } }
  @keyframes chip-in { from { opacity:0; transform:translateY(15px); } to { opacity:1; transform:translateY(0); } }
  @keyframes chip-hover { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-5px); } }
  @keyframes draw-line { to { stroke-dashoffset:0; } }
  @keyframes dot-in { from { opacity:0; transform:scale(.5); transform-origin:260px 12px; } to { opacity:1; transform:scale(1); transform-origin:260px 12px; } }
  @media (max-width: 1070px) {
    .hero-layout { grid-template-columns:1fr; gap:2.7rem; min-height:0; }
    .hero-copy { max-width:720px; }
    .hero-demo { max-width:610px; }
    .home-hero { padding-top:4rem; }
  }
  @media (max-width: 620px) {
    .home-hero { padding-block:3.5rem 4.5rem; }
    .hero-copy .display { font-size:clamp(2.8rem, 9.6vw, 4.1rem); }
    .hero-lead { font-size:1.07rem; }
    .hero-demo { height:445px; }
    .calendar-card { top:34px; width:100%; padding:.85rem .6rem 1rem; }
    .calendar-head { padding:0 .35rem .8rem; }
    .calendar-title { font-size:1.32rem; }
    .calendar-caption { font-size:.64rem; }
    .day-labels { grid-template-columns:37px repeat(5,minmax(0,1fr)); }
    .day-labels span { font-size:.63rem; }
    .schedule { height:286px; }
    .time-labels { width:37px; }
    .time-labels span { height:35.75px; font-size:.56rem; }
    .day-column { background:repeating-linear-gradient(to bottom,transparent 0,transparent 34.75px,#dce3ee 34.75px,#dce3ee 35.75px); }
    .appointment { top:var(--mobile-top); height:var(--mobile-height); font-size:.51rem; padding:3px; left:2px; right:2px; }
    .lead-note { left:-4px; top:0; transform-origin:left top; }
    .booked-note { bottom:81px; right:-4px; padding:.48rem .6rem; }
    .floating-chip strong { font-size:.75rem; }
    .floating-chip div span { font-size:.6rem; }
    .chip-icon { width:27px; height:27px; font-size:.9rem; }
    .revenue-card { width:200px; left:-4px; bottom:0; padding:.7rem .8rem; }
    .revenue-head strong { font-size:1rem; }
    .revenue-chart { height:43px; }
    .demo-disclaimer { bottom:-27px; right:4px; font-size:.57rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .calendar-card,.appointment,.floating-chip,.revenue-card,.revenue-path,.revenue-dot { animation:none !important; }
    .revenue-path { stroke-dashoffset:0; }
  }
</style>
