---
// Text wordmarks until we have permission to use real logos.
interface Props { title?: string }
const { title = "Built on the platforms your practice already runs" } = Astro.props;
const platforms = [
  { name: "GoHighLevel", href: "/integrations/gohighlevel/" },
  { name: "Zenoti", href: "/integrations/zenoti/" },
  { name: "OptiMantra", href: "/integrations/providi/" },
  { name: "Cerbo", href: "/integrations/cerbo/" },
  { name: "Google Ads", href: "/services/google-ads/" },
  { name: "Meta", href: "/services/meta-ads/" },
];
---
<div class="strip">
  <h2 class="strip-title">{title}</h2>
  <ul role="list">
    {platforms.map((p) => <li><a href={p.href}>{p.name}</a></li>)}
  </ul>
</div>
<style>
  .strip {
    background: var(--mist);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }
  .strip-title {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 720px) {
    ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    ul { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }
  a {
    display: grid;
    place-items: center;
    min-height: 64px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    font: 600 1rem/1 var(--font-body);
    color: var(--text-2);
    text-decoration: none;
    transition: color 150ms var(--ease), border-color 150ms var(--ease);
  }
  a:hover {
    color: var(--ink);
    border-color: var(--steel);
  }
</style>
