---
// Platform wordmarks on a slow loop (react-bits LogoLoop). Text until we have logo permission.
import PlatformLoop from "./motion/PlatformLoop";
interface Props { title?: string }
const { title = "Built on the platforms your practice already runs" } = Astro.props;
---
<div class="strip">
  <h2 class="strip-title">{title}</h2>
  <PlatformLoop client:visible />
</div>
<style>
  .strip {
    background: var(--mist);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem) 0;
    overflow: hidden;
  }
  .strip-title {
    font-size: 1.5rem;
    margin: 0 clamp(1.25rem, 1rem + 1vw, 2rem) 1.25rem;
  }
  .strip :global(.pl-chip) {
    display: grid;
    place-items: center;
    height: 64px;
    padding: 0 2rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    font: 700 1.3rem/1 var(--font-head);
    letter-spacing: 0.01em;
    color: var(--text-2);
    white-space: nowrap;
    transition: color 150ms var(--ease), border-color 150ms var(--ease);
  }
  .strip :global(a:hover .pl-chip) {
    color: var(--ink);
    border-color: var(--steel);
  }
</style>
