---
import Icon from "./Icon.astro";
import StatNumber from "./motion/StatNumber";
import { hl } from "../lib/hl";
import { serviceBySlug } from "../data/services";
interface Props { slug: string; data: any; dark?: boolean }
const { slug, data, dark = false } = Astro.props;
---
<a href={`/case-studies/${slug}/`} class:list={["card card--link case", { "card--ink on-ink": dark }]} data-vertical={data.vertical} data-services={data.services.join(" ")}>
  <div class="tags">
    <span class="tag">{data.verticalLabel}</span>
    {data.services.map((s: string) => <span class="tag">{serviceBySlug(s)?.name}</span>)}
  </div>
  <p class="big"><StatNumber client:visible={{ rootMargin: "160px" }} value={data.headline.value} /></p>
  <p class="big-label">{data.headline.label}</p>
  <h3 set:html={hl(data.title)} />
  <div class="foot">
    <span>{data.client} · {data.location}</span>
    <span class:list={["arrow", { "arrow--ink": dark }]}><Icon name="arrow" /></span>
  </div>
</a>
<style>
  .case { display: flex; flex-direction: column; height: 100%; }
  .big {
    margin-top: 2rem;
    font: 700 clamp(3rem, 2.4rem + 2.6vw, 4.5rem)/1 var(--font-head);
    letter-spacing: 0;
    color: var(--azure);
  }
  .on-ink .big { color: var(--white); }
  .big-label { margin-top: 0.6rem; font-size: var(--fs-small); max-width: 38ch; }
  h3 { margin-top: 1.75rem; font-size: 1.3rem; }
  .foot {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    margin-top: auto; padding-top: 1.75rem; font-size: var(--fs-small); color: var(--text-3);
  }
  .on-ink .foot { color: var(--on-ink-2); }
</style>
