---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import InlineIllo from "../components/InlineIllo.astro";

const phases = [
  {
    when: "Week 1",
    title: "Onboarding",
    items: [
      "Kickoff call with the owner and whoever runs the front desk",
      "Access to ad accounts, CRM, EMR or booking, Google Business Profile and analytics",
      "Audit of tracking, campaigns, follow-up and the last 90 days of leads",
      "Agreement on the two or three numbers we'll be judged on",
    ],
  },
  {
    when: "Days 1–30",
    title: "Fix the foundation",
    items: [
      "Review conversion goals and remove duplicate or misleading events before evaluating performance",
      "Review click attribution, CRM stages and the booking handoff wherever the stack allows",
      "Useful first replies and a clear owner for every inbound inquiry",
      "Landing pages for the treatments we're advertising",
      "Campaigns restructured or launched",
    ],
  },
  {
    when: "Days 31–60",
    title: "Learn and tighten",
    items: [
      "Evaluate offline conversions once event availability, consent and ad-platform requirements are confirmed",
      "Review search terms, lead quality and front-desk feedback before reallocating budget",
      "Evaluate initial Meta creative and offer tests against lead quality and available booking data",
      "Front desk feedback loop: which leads were real, which weren't",
    ],
  },
  {
    when: "Days 61–90",
    title: "Scale what works",
    items: [
      "Shift effort toward the offers and channels producing the most useful inquiries and appointments",
      "Scope retention or reactivation workflows where the patient journey makes them useful",
      "Adjust bidding strategies only once conversion volume and measurement quality support the change",
      "A 90-day review: what worked, what didn't, the plan for the next quarter",
    ],
  },
];

const cadence = [
  { t: "Weekly", b: "A concise review of changes, early observations and questions the team needs to answer. The agreed cadence depends on the account." },
  { t: "Monthly", b: "A useful review of campaign spend, valid inquiries, booking data where available, what we changed and what we recommend next." },
  { t: "Quarterly", b: "A strategy review with the owner. Treatments to push, offers to retire, budget for the next quarter." },
  { t: "Always", b: "Clear ownership of strategy, implementation and questions, with communication expectations set during onboarding." },
];
---
<Base title="How it works" description="How working with NexaMed works: onboarding, the first 30, 60 and 90 days, reporting cadence, and who we're not a fit for.">
  <PageHero
    title="One path from ad click to [[booked patient]]."
    lead="First we learn how your practice sells its services, how inquiries arrive and where people drop off. Then we improve the campaigns and handoffs that matter. This is an example of the first 90 days; the real sequence depends on your existing systems."
    crumbs={[{ label: "How it works" }]}
    center
    primary={{ label: "Book a strategy call", href: "/book/" }}
    secondary={{ label: "See pricing", href: "/pricing/" }}
  >
    <div class="hiw-art"><InlineIllo name="patient-path" /></div>
  </PageHero>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head"><h2>The first <mark>90 days</mark>.</h2></div>
      <ol class="timeline" role="list">
        {phases.map((p) => (
          <li class="card" data-reveal>
            <span class="num">{p.when}</span>
            <h3>{p.title}</h3>
            <ul class="checks" role="list">{p.items.map((i) => <li>{i}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--white">
    <div class="container split split--wide-right">
      <div>
        <h2>Reporting you'll <mark>actually read</mark>.</h2>
        <p class="lead" style="margin-top:1.25rem">Written by the person running your account, in plain language, tied to booked patients.</p>
      </div>
      <dl class="cadence">
        {cadence.map((c) => (
          <div><dt>{c.t}</dt><dd>{c.b}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--ink" id="not-a-fit">
    <div class="container split">
      <div>
        <h2>Who we're <mark>not a fit</mark> for.</h2>
        <p class="lead" style="margin-top:1.25rem">
          We'd rather say this now than six months into a retainer.
        </p>
      </div>
      <ul class="checks checks--x" role="list">
        <li>Practices whose revenue runs mostly through insurance.</li>
        <li>Anyone judging success on cost per lead alone.</li>
        <li>Practices where nobody can follow up with a lead the same day.</li>
        <li>Owners who want guaranteed numbers before we've seen the account.</li>
        <li>Treatments or claims that won't pass ad policy or LegitScript review.</li>
        <li>A practice in a market where we already work with a direct competitor.</li>
      </ul>
    </div>
  </section>
</Base>
<style>
  .hiw-art { max-width: 1100px; margin: 3rem auto 0; }
  .hiw-art :global(img) { width: 100%; }
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 900px) { .timeline { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1200px) { .timeline { grid-template-columns: repeat(4, 1fr); } }
  .timeline h3 { margin: 0.5rem 0 1rem; }
  .timeline :global(.checks li) { font-size: var(--fs-small); }
  .cadence { margin: 0; display: grid; gap: 0; }
  .cadence > div { display: grid; gap: 0.35rem; padding: 1.25rem 0; border-top: 1px solid var(--line); }
  .cadence > div:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 640px) { .cadence > div { grid-template-columns: 140px 1fr; gap: 1.5rem; } }
  dt { font: 700 1.15rem/1.3 var(--font-head); letter-spacing: 0; }
  dd { margin: 0; color: var(--text-2); }
  .section--ink :global(.checks li) { color: var(--on-ink-2); }
</style>
