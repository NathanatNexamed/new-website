---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import MedPlus from "../components/MedPlus.astro";
import { team } from "../data/team";

const principles = [
  { t: "Booked patients are the number", b: "Not leads, not clicks, not impressions. If we can't tie it to a booked consult, we say so." },
  { t: "One practice per market", b: "We don't run your competitor's ads. Your account gets our full attention and our best thinking." },
  { t: "Say the uncomfortable thing early", b: "If the offer is weak, the front desk is slow, or the market's too small, you'll hear it from us first." },
  { t: "You own everything", b: "Ad accounts, CRM, pages and data stay in your name. No hostage situations." },
];
const initials = (n: string) => n.replace(/[\[\]]/g, "").split(" ").map((w) => w[0]).join("").slice(0, 2);
---
<Base title="About" description="NexaMed is a healthcare-only marketing team for cash-pay practices, started by people who worked inside one.">
  <PageHero
    title="We started [[inside a practice]]."
    lead="NexaMed was started by people who ran marketing and operations from inside a cash-pay clinic. We saw how much revenue was lost between the ad click and the front desk, and how few agencies looked past the lead. So we built the agency we would have hired."
    crumbs={[{ label: "About" }]}
    illo="owner-results"
    secondary={{ label: "How we work", href: "/how-it-works/" }}
  />

  <section class="section section--mist">
    <div class="container">
      <div class="section-head"><h2>How we <mark>operate</mark>.</h2></div>
      <div class="grid grid--2">
        {principles.map((p, i) => (
          <div class="card" data-reveal>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <h3 style="margin-top:0.75rem">{p.t}</h3>
            <p>{p.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white" id="team">
    <div class="container">
      <div class="section-head"><h2>The team</h2></div>
      <div class="grid grid--4">
        {team.map((p) => (
          <article class="person">
            <div class="avatar" aria-hidden="true">{initials(p.name)}</div>
            <h3>{p.name}</h3>
            <p class="role">{p.role}</p>
            <p class="short">{p.short}</p>
            {p.slug === "nathan-smith" && <a class="link-arrow" href={`/blog/author/${p.slug}/`}>Bio and articles <Icon name="arrow" class="i16" /></a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section dots-ink on-ink about-q">
    <div class="container">
      <MedPlus size={72} flat />
      <p class="aq">We'd rather tell you we're <mark>not a fit</mark> than take a retainer we can't earn.</p>
      <p class="aq-by">Nathan Smith, Founder &amp; CEO</p>
    </div>
  </section>
</Base>
<style>
  .person { display: grid; gap: 0.35rem; align-content: start; }
  .avatar {
    aspect-ratio: 1; border-radius: var(--radius-lg); background: var(--ice); color: var(--azure);
    display: grid; place-items: center; font: 600 2.5rem/1 var(--font-head); margin-bottom: 1rem;
  }
  .person h3 { font-size: 1.25rem; }
  .role { color: var(--azure); font-weight: 600; font-size: var(--fs-small); }
  .short { color: var(--text-2); font-size: var(--fs-small); }
  .person .link-arrow { margin-top: 0.5rem; font-size: var(--fs-small); }
  .about-q { color: #fff; }
  .aq { margin-top: 2rem; max-width: 22ch; font: 600 clamp(2rem, 1.4rem + 2.6vw, 3.75rem)/1.06 var(--font-head); letter-spacing: -0.03em; }
  .aq-by { margin-top: 1.5rem; color: var(--on-ink-2); }
  :global(.i16) { width: 16px; height: 16px; }
</style>
