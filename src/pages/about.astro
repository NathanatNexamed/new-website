---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import MedPlus from "../components/MedPlus.astro";
import { team } from "../data/team";
import FounderQuote from "../components/motion/FounderQuote";

const principles = [
  { t: "A lead is the start, not the result", b: "We look for booked and attended appointments when the data exists, and never present a form submission as a paying patient." },
  { t: "Learn the practice before writing the ads", b: "We ask which services are profitable, how people book, and what past campaigns missed before recommending a channel." },
  { t: "Fix the obvious problem first", b: "A better first reply or a clearer service page can matter more than another automation. We start where the evidence points." },
  { t: "Work in your systems", b: "We aim to keep you in control of your accounts and assets, and explain integration and software dependencies up front." },
];
const initials = (n: string) => n.replace(/[\[\]]/g, "").split(" ").map((w) => w[0]).join("").slice(0, 2);
---
<Base title="About" description="NexaMed is a healthcare-only marketing team for cash-pay practices, started by people who worked inside one.">
  <PageHero
    title="We understand the gap between [[a lead and a patient]]."
    lead="NexaMed works with med spas and cash-pay practices on both sides of growth: attracting the right people and making sure those people get useful answers. That means caring about the front desk, booking software and follow-up as much as the ad campaign."
    crumbs={[{ label: "About" }]}
    illo="owner-results"
    secondary={{ label: "How we work", href: "/how-it-works/" }}
  />

  <section class="section section--mist">
    <div class="container">
      <div class="section-head"><h2>How we <mark>operate</mark>.</h2></div>
      <div class="grid grid--2">
        {principles.map((p, i) => (
          <div class="card" data-reveal>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <h3 style="margin-top:0.75rem">{p.t}</h3>
            <p>{p.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white" id="team">
    <div class="container">
      <div class="section-head"><h2>The team</h2></div>
      <div class="grid grid--4">
        {team.map((p) => (
          <article class="person">
            <div class="avatar" aria-hidden="true">{initials(p.name)}</div>
            <h3>{p.name}</h3>
            <p class="role">{p.role}</p>
            <p class="short">{p.short}</p>
            {p.slug === "nathan-smith" && <a class="link-arrow" href={`/blog/author/${p.slug}/`}>Bio and articles <Icon name="arrow" class="i16" /></a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section dots-ink on-ink about-q">
    <div class="container">
      <MedPlus size={72} flat />
      <div class="aq"><FounderQuote client:visible text="We’d rather tell you we’re not a fit than take a retainer we can’t earn." markWords={[5, 7]} /></div>
      <p class="aq-by">Nathan Smith, Founder &amp; CEO</p>
    </div>
  </section>
</Base>
<style>
  .person { display: grid; gap: 0.35rem; align-content: start; }
  .avatar {
    aspect-ratio: 1; border-radius: var(--radius-lg); background: var(--ice); color: var(--azure);
    display: grid; place-items: center; font: 700 2.5rem/1 var(--font-head); margin-bottom: 1rem;
  }
  .person h3 { font-size: 1.25rem; }
  .role { color: var(--azure); font-family: var(--font-ui); font-weight: 700; font-size: var(--fs-small); }
  .short { color: var(--text-2); font-size: var(--fs-small); }
  .person .link-arrow { margin-top: 0.5rem; font-size: var(--fs-small); }
  .about-q { color: #fff; }
  .aq :global(.fq) { margin: 0; font: inherit; }
  .aq { margin-top: 2rem; max-width: 22ch; font: 700 clamp(2rem, 1.4rem + 2.6vw, 3.75rem)/1.06 var(--font-head); letter-spacing: 0; }
  .aq-by { margin-top: 1.5rem; color: var(--on-ink-2); }
  :global(.i16) { width: 16px; height: 16px; }
</style>
