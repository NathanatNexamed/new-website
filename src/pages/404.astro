---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" noindex hideFooterCta>
  <section class="section section--mist">
    <div class="container narrow" style="text-align:center">
      <h1>This page <mark>didn't convert</mark>.</h1>
      <p class="lead" style="margin-top:1.25rem">It may have moved. Try one of these instead.</p>
      <div class="btn-row btn-row--center" style="margin-top:2rem">
        <a class="btn" href="/">Home</a>
        <a class="btn btn--outline" href="/services/">Services</a>
        <a class="btn btn--outline" href="/blog/">Blog</a>
      </div>
    </div>
  </section>
</Base>
