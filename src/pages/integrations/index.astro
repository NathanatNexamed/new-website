---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import RelatedCards from "../../components/RelatedCards.astro";
import Illo from "../../components/Illo.astro";
import { liveIntegrations } from "../../data/integrations";
---
<Base title="Integrations" description="How NexaMed evaluates CRM and EMR connections for Cerbo, OptiMantra, Zenoti and GoHighLevel, including field availability and workflow design.">
  <PageHero
    roomy
    title="Connect the systems behind [[each patient inquiry]]."
    lead="The first question is not whether two platforms have logos on an integration diagram. It is whether your staff can reliably see who inquired, who booked and who needs a follow-up. We assess supported webhooks, APIs and consent before promising any specific sync."
    crumbs={[{ label: "Services", href: "/services/" }, { label: "CRM & Automations", href: "/services/crm-automations/" }, { label: "Integrations" }]}
    illo="connected-stack"
    primary={{ label: "Schedule My Call", href: "/book/" }}
  />
  <section class="section section--mist">
    <div class="container">
      <div class="section-head"><h2>Platforms we build on</h2></div>
      <RelatedCards cols={2} items={liveIntegrations.map((i) => ({ title: i.name, body: `${i.category}. ${i.short}`, href: `/integrations/${i.slug}/` }))} />
      <p class="note">Running something else? We can review what your platform makes available. Not every EMR supports the same events or access methods.</p>
    </div>
  </section>
  <section class="section section--white">
    <div class="container split">
      <div>
        <h2>What a connected stack <mark>actually changes</mark>.</h2>
        <ul class="checks" style="margin-top:2rem" role="list">
          <li>Give the front desk a clear place to manage marketing inquiries and conversations.</li>
          <li>Update pipeline stages from supported appointment events where technically possible.</li>
          <li>Improve attribution using permitted downstream events when clean matching is available.</li>
          <li>Keep clinical data in the appropriate systems and review every field before it reaches marketing tools.</li>
        </ul>
      </div>
      <Illo name="front-desk" />
    </div>
  </section>
</Base>
<style>.note { margin-top: 1.5rem; color: var(--text-2); }</style>
