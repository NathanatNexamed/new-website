---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import FaqList from "../../components/FaqList.astro";
import RelatedCards from "../../components/RelatedCards.astro";
import { liveIntegrations, type Integration } from "../../data/integrations";

export function getStaticPaths() {
  return liveIntegrations.map((i) => ({ params: { slug: i.slug }, props: { i } }));
}
const { i } = Astro.props as { i: Integration };
const others = liveIntegrations.filter((x) => x.slug !== i.slug);
---
<Base title={`${i.name} integration`} description={i.metaDescription}>
  <PageHero
    title={i.title}
    lead={i.lead}
    crumbs={[{ label: "Integrations", href: "/integrations/" }, { label: i.name }]}
    illo="connected-stack"
    primary={{ label: "Schedule My Call", href: "/book/" }}
    secondary={{ label: "CRM & automations", href: "/services/crm-automations/" }}
  />
  <section class="section section--mist">
    <div class="container">
      <div class="section-head"><h2>What we set up</h2></div>
      <div class="grid grid--2">
        {i.flows.map((f, n) => (
          <div class="card" data-reveal>
            <span class="num">{String(n + 1).padStart(2, "0")}</span>
            <h3 style="margin-top:0.75rem">{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--ink">
    <div class="container split">
      <h2>What <mark>syncs</mark>.</h2>
      <ul class="checks" role="list">{i.syncs.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>
  <section class="section section--white">
    <div class="container narrow">
      <h2 style="margin-bottom:2rem">{i.name} questions</h2>
      <FaqList items={i.faqs} />
    </div>
  </section>
  <section class="section section--mist section--tight">
    <div class="container">
      <h2 style="font-size:var(--fs-h3);margin-bottom:1.5rem">Other integrations</h2>
      <RelatedCards items={others.map((o) => ({ title: o.name, body: o.short, href: `/integrations/${o.slug}/` }))} />
    </div>
  </section>
</Base>
