---
// One thank-you page per guide (CMS-templated from src/content/guides). noindex; conversions fire here.
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import CaseCard from "../../components/CaseCard.astro";
import { plain } from "../../lib/hl";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const cs = await getEntry("caseStudies", g.data.readNext);
---
<Base title="Your guide is on its way" noindex hideFooterCta>
  <script is:inline slot="head" define:vars={{ slug: g.id }}>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: "guide_download", guide: slug });
  </script>
  <section class="section section--mist">
    <div class="container narrow ty">
      <h1>Check your <mark>inbox</mark>.</h1>
      <p class="lead">“{plain(g.data.title)}” is on its way. If it isn't there in five minutes, check promotions or spam.</p>
    </div>
  </section>
  {cs && (
    <section class="section section--white">
      <div class="container split split--wide-right">
        <div>
          <h2>Read this case study before we talk.</h2>
          <p class="lead" style="margin-top:1.25rem">It's the same setup the guide walks through, running in a live account.</p>
          <div class="btn-row" style="margin-top:2rem"><a class="btn btn--outline" href="/book/">Book a strategy call</a></div>
        </div>
        <CaseCard slug={cs.id} data={cs.data} />
      </div>
    </section>
  )}
</Base>
<style>
  .ty .lead { margin-top: 1.25rem; }
</style>
