---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import FaqList from "../components/FaqList.astro";
import Icon from "../components/Icon.astro";
import { pricingFaqs } from "../data/faq";

// Scopes are examples, not published packages or blanket promises.
const plans = [
  {
    name: "Patient acquisition",
    price: "Custom scope",
    per: "",
    for: "For clinics that need better search or social acquisition, without paying for services they don't need.",
    includes: [
      "Google Ads or Meta Ads strategy and management",
      "Service-specific offers and landing page recommendations",
      "Campaign measurement and lead-quality reviews",
      "Reporting tied to available booking data",
    ],
  },
  {
    name: "Acquisition + follow-up",
    price: "Custom scope",
    per: "",
    featured: true,
    for: "For practices where inquiries are coming in but the booking and follow-up process needs attention.",
    includes: [
      "Paid acquisition strategy and management",
      "GoHighLevel pipelines, messaging and follow-up workflows",
      "Booking or EMR integration discovery and implementation, where supported",
      "Conversion and operational reporting",
      "Ongoing testing based on patient and staff feedback",
    ],
  },
  {
    name: "Search visibility & specialist projects",
    price: "Quoted separately",
    per: "",
    for: "For practices improving local search, treatment content or a specific operational bottleneck.",
    includes: [
      "SEO for priority treatment and location pages",
      "AEO and content structure",
      "LegitScript application assistance when applicable",
      "CRM audits, reactivation and integration projects",
    ],
  },
];
---
<Base title="Pricing" description="How NexaMed pricing works: a flat monthly fee by scope, ad spend paid directly to the platforms, no percentage of spend, and accounts you own.">
  <PageHero
    title="Pricing based on [[what your practice needs]]."
    lead="There is a big difference between managing an ad account and rebuilding the way a clinic responds to leads. We scope the work based on your services, markets, systems and existing team. Ad spend and third-party software costs are separate."
    crumbs={[{ label: "Pricing" }]}
    center
  />

  <section class="section section--mist">
    <div class="container">
      <div class="grid grid--3 plans">
        {plans.map((p) => (
          <div class:list={["card plan", { "card--ink on-ink": p.featured }]}>
            <h2 class="plan-name">{p.name}</h2>
            <p class="plan-for">{p.for}</p>
            <p class="plan-price"><span>{p.price}</span>{p.per}</p>
            <ul class="checks" role="list">{p.includes.map((i) => <li>{i}</li>)}</ul>
            <a href="/book/" class:list={["btn", { "btn--outline": !p.featured }]}>Book a call</a>
          </div>
        ))}
      </div>
      <p class="note">
        Our typical ongoing engagements start at $5,000 per month. Setup work, software, advertising budgets and any project-specific fees are itemized in the proposal. Terms depend on the agreed scope.
      </p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container split">
      <div>
        <h2>What's <mark>not</mark> in the fee</h2>
        <p class="lead" style="margin-top:1.25rem">So there are no surprises later.</p>
      </div>
      <ul class="checks checks--x" role="list">
        <li>Ad spend. Billed by Google and Meta directly.</li>
        <li>Software subscriptions: GoHighLevel, your EMR, call tracking.</li>
        <li>LegitScript's own application and annual fees.</li>
        <li>Photo and video shoots, if you want more than we can do with what you film.</li>
      </ul>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container split">
      <div>
        <h2>Not sure which you need?</h2>
        <p class="lead" style="margin-top:1.25rem">
          Most practices don't need every service. We'll ask about your most important treatments, current lead volume, booking process and software before recommending work. Sometimes the first fix isn't another ad.
        </p>
      </div>
      <div class="btn-row">
        <a href="/book/" class="btn">Book a strategy call</a>
        <a href="/how-it-works/" class="btn btn--outline-light">How it works</a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container narrow">
      <h2 style="margin-bottom:2rem">Pricing questions</h2>
      <FaqList items={pricingFaqs} schema />
      <p style="margin-top:2rem"><a class="link-arrow" href="/faq/">More questions <Icon name="arrow" class="i16" /></a></p>
    </div>
  </section>
</Base>
<style>
  .plans { align-items: stretch; }
  .plan { display: flex; flex-direction: column; gap: 1.25rem; padding: 2rem; }
  .plan-name { font-size: 1.5rem; }
  .plan-for { min-height: 3.2em; }
  .plan-price { font-size: var(--fs-small); color: var(--text-3); }
  .on-ink .plan-price { color: var(--on-ink-2); }
  .plan-price span { font: 700 2.6rem/1 var(--font-head); letter-spacing: 0; color: var(--ink); margin-right: 0.25rem; }
  .on-ink .plan-price span { color: #fff; }
  .plan .checks { flex: 1; }
  .plan .btn { width: 100%; }
  .on-ink :global(.checks li) { color: var(--on-ink-2); }
  .note { margin-top: 1.75rem; text-align: center; color: var(--text-2); font-size: var(--fs-small); }
  :global(.i16) { width: 16px; height: 16px; }
</style>
