---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import Illo from "../../components/Illo.astro";
import PlatformStrip from "../../components/PlatformStrip.astro";
import { services } from "../../data/services";
const top = services.filter((s) => !s.parent);
---
<Base title="Services" description="Google Ads, Meta Ads, SEO & AEO, CRM & automations, and LegitScript certification for medspas and cash-pay clinics.">
  <PageHero
    title="Growth services built around [[how clinics actually book]]."
    lead="We don't prescribe Google Ads, Meta, SEO and automations to every clinic. First we look at which treatments you need to grow, how inquiries arrive and what happens after someone asks about an appointment."
    crumbs={[{ label: "Services" }]}
    center
    primary={{ label: "Schedule My Call", href: "/book/" }}
    secondary={{ label: "How it works", href: "/how-it-works/" }}
  />

  <section class="section section--mist">
    <div class="container">
      <ul class="svc-list" role="list">
        {top.map((s, i) => {
          const kids = services.filter((k) => k.parent === s.slug);
          return (
            <li class:list={["card", "svc", { "card--ink on-ink": i % 3 === 1 }]} data-reveal>
              <div class="svc-copy">
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                <h2 class="svc-name"><a href={`/services/${s.slug}/`}>{s.name}</a></h2>
                <p>{s.short}</p>
                <ul class="svc-points" role="list">
                  {s.work.slice(0, 3).map((w) => <li>{w.title}</li>)}
                </ul>
                {kids.map((k) => (
                  <p class="kid"><a href={`/services/${k.slug}/`} class="link-arrow">Includes {k.name}: {k.short} <Icon name="arrow" class="i16" /></a></p>
                ))}
              </div>
              <div class="svc-art illustration-drift"><Illo name={s.illo} decorative /></div>
              <span class:list={["arrow", { "arrow--ink": i % 3 === 1 }]} aria-hidden="true"><Icon name="arrow" /></span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section section--white service-outro">
    <div class="container split">
      <div>
        <h2>Start with the <mark>constraint</mark>, not the service list.</h2>
        <p class="lead" style="margin-top:1.25rem">
          A clinic with a strong offer but no inquiries needs a different plan from one with hundreds of unanswered leads. We identify the bottleneck before recommending another campaign or software build.
        </p>
        <div class="btn-row" style="margin-top:2rem"><a class="btn" href="/book/">Schedule My Call</a></div>
      </div>
      <div class="service-outro-art illustration-drift"><Illo name="connected-stack" /></div>
    </div>
  </section>

  <section class="section section--white section--tight" style="padding-top:0">
    <div class="container"><PlatformStrip /></div>
  </section>
</Base>

<style>
  .svc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .svc {
    display: grid;
    gap: clamp(2.5rem, 4vw, 4.75rem);
    align-items: center;
    position: relative;
  }
  @media (min-width: 900px) {
    .svc { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); padding: 2.5rem 3rem; }
  }
  .svc-name { font-size: var(--fs-h3); margin-top: 0.5rem; }
  .svc-name a { text-decoration: none; }
  .svc-name a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .svc-copy > p { margin-top: 0.75rem; max-width: 55ch; }
  .svc-points { list-style: none; padding: 0; margin: 1.25rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .svc-points li {
    font-size: var(--fs-xs); font-weight: 400; padding: 0.3rem 0.65rem;
    border: 1px solid var(--line); border-radius: 6px; color: var(--text-2);
  }
  .on-ink .svc-points li { border-color: var(--ink-line); color: var(--on-ink-2); }
  .kid { position: relative; z-index: 1; margin-top: 1.25rem; font-size: var(--fs-small); }
  .svc-art { min-width: 0; }
  .svc-art :global(img) { max-height: 310px; width: 100%; max-width: 480px; object-fit: contain; margin-inline: auto; }
  .on-ink .svc-art { background: var(--mist); border-radius: 16px; padding: 1rem; }
  .svc > .arrow { position: absolute; top: 1.5rem; right: 1.5rem; }
  .svc:hover > .arrow { background: var(--azure); border-color: var(--azure); color: #fff; }
  .service-outro-art { min-width: 0; width: 100%; }
  .service-outro-art :global(img) { width: 100%; max-width: 620px; margin-inline: auto; }
  @media (min-width: 960px) {
    .service-outro .split { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(3.5rem, 6vw, 7rem); }
    .service-outro-art :global(img) { transform: scale(1.06); }
  }
  :global(.i16) { width: 16px; height: 16px; flex: none; }
</style>
