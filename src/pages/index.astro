---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Illo from "../components/Illo.astro";
import InlineIllo from "../components/InlineIllo.astro";
import HeroExperience from "../components/HeroExperience.astro";
import Icon from "../components/Icon.astro";
import MedPlus from "../components/MedPlus.astro";
import ProofStats from "../components/ProofStats.astro";
import ReportPanel from "../components/ReportPanel.astro";
import CaseCard from "../components/CaseCard.astro";
import PostCard from "../components/PostCard.astro";
import PlatformStrip from "../components/PlatformStrip.astro";
import FounderQuote from "../components/motion/FounderQuote";
import { services } from "../data/services";
import { verticals } from "../data/verticals";

const cases = (await getCollection("caseStudies")).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const svc = Object.fromEntries(services.map((s) => [s.slug, s]));
const path = [
  { n: "01", t: "The right offer", b: "We choose a treatment patients actually want and a page that answers the question behind the ad. Not the same generic booking page for every service." },
  { n: "02", t: "A useful first reply", b: "When a lead asks about price or availability, your team should answer that question, not paste a calendar link and hope." },
  { n: "03", t: "Appointment recorded", b: "We map the booking handoff. Where integrations permit, status updates the CRM; otherwise we design a reliable process for staff." },
  { n: "04", t: "Learn from outcomes", b: "We compare lead quality and booked visits with spend. If the data supports offline conversions, we use them to improve bidding." },
];
---
<Base title="NexaMed">
  <!-- Visual hero: illustrative booking calendar and revenue trend -->
  <HeroExperience />

  <!-- Proof -->
  <section class="section--white proof-wrap">
    <div class="container">
      <ProofStats
        stats={[
          { value: "890", label: "Meta leads in Beautiful U case study" },
          { value: "500", label: "Of those leads who replied" },
          { value: "12–15%", label: "Avg. conversion rate · Pure Hydration" },
          { value: "56%", label: "Of leads replied · Beautiful U" },
        ]}
      />
    </div>
  </section>

  <!-- Fit -->
  <section class="section section--mist">
    <div class="container">
      <div class="section-head section-head--split">
        <h2>For owners who need more than another <mark>ad dashboard</mark>.</h2>
        <p class="lead">
          You might have plenty of leads but not enough appointments. Or a packed CRM that nobody follows up in. We start by finding where the handoff breaks, then decide whether the answer is better ads, a better offer, or a better process.
        </p>
      </div>
      <div class="grid grid--2">
        <div class="card" data-reveal>
          <h3>We're a good fit if</h3>
          <ul class="checks" style="margin-top:1.25rem">
            <li>You run an established med spa or cash-pay clinic and know which services you want to grow.</li>
            <li>You're willing to look beyond the ad account at how leads are contacted and booked.</li>
            <li>You'd rather test a strong service offer than advertise every item on the menu at once.</li>
            <li>You want clear reporting and candid feedback, including when a campaign isn't ready to scale.</li>
          </ul>
        </div>
        <div class="card" data-reveal>
          <h3>We're not a fit if</h3>
          <ul class="checks checks--x" style="margin-top:1.25rem">
            <li>You're only interested in the lowest cost per form submission.</li>
            <li>Nobody owns inbound inquiries or is willing to improve follow-up.</li>
            <li>You expect a guaranteed number of patients before we've seen your market and process.</li>
            <li>You want to launch restricted medical claims without checking platform policy.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Services bento -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head section-head--center">
        <h2>Marketing only works when the next step <mark>actually happens</mark>.</h2>
        <p class="lead">
          Some clinics need better demand. Others need to stop losing the demand they already have. We look at the whole path, then focus on the part holding growth back.
        </p>
      </div>
      <div class="bento">
        <a href="/services/crm-automations/" class="card card--link b-crm" data-reveal>
          <div class="b-top">
            <span class="tag">GoHighLevel</span>
            <span class="arrow"><Icon name="arrow" /></span>
          </div>
          <h3 class="b-title-lg">CRM &amp; automations</h3>
          <p>{svc["crm-automations"].short}</p>
          <div class="b-art"><Illo name="front-desk" /></div>
        </a>
        <a href="/services/google-ads/" class="card card--ink card--link b-sm" data-reveal>
          <div class="b-top"><h3>Google Ads</h3><span class="arrow arrow--ink"><Icon name="arrow" /></span></div>
          <p>{svc["google-ads"].short}</p>
        </a>
        <a href="/services/meta-ads/" class="card card--link b-sm" data-reveal>
          <div class="b-top"><h3>Meta Ads</h3><span class="arrow"><Icon name="arrow" /></span></div>
          <p>{svc["meta-ads"].short}</p>
        </a>
        <a href="/services/seo/" class="card card--link b-sm" data-reveal>
          <div class="b-top"><h3>SEO &amp; AEO</h3><span class="arrow"><Icon name="arrow" /></span></div>
          <p>Build useful treatment pages, local visibility, and trustworthy answers to the questions prospective patients search.</p>
        </a>
        <a href="/services/legitscript-certification/" class="card card--ink card--link b-sm" data-reveal>
          <div class="b-top"><h3>LegitScript certification</h3><span class="arrow arrow--ink"><Icon name="arrow" /></span></div>
          <p>{svc["legitscript-certification"].short}</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Reporting -->
  <section class="section section--ink">
    <div class="container split split--wide-right">
      <div>
        <h2>Know which marketing brings in <mark>real appointments</mark>.</h2>
        <p class="lead" style="margin-top:1.25rem">
          An ad platform might call a page view a conversion. Your front desk calls a booked consultation a conversion. We work to reconcile those numbers using data your systems can safely share.
        </p>
        <ul class="feature-rows" role="list">
          <li>
            <span class="arrow fr-on"><Icon name="arrow-up-right" /></span>
            <div>
              <h3>See which ads book patients</h3>
              <p>Where tracking and booking records allow it, we connect a lead source with the consultation it produced. When they do not, we explain the gap.</p>
            </div>
          </li>
          <li>
            <span class="arrow arrow--ink"><Icon name="arrow-up-right" /></span>
            <div>
              <h3>Conversions sent back to Google Ads</h3>
              <p>When clean matching is possible and data is appropriate to share, offline conversion events can help Google optimize beyond form submissions.</p>
            </div>
          </li>
          <li>
            <span class="arrow arrow--ink"><Icon name="arrow-up-right" /></span>
            <div>
              <h3>Monthly context, not a raw dashboard</h3>
              <p>What changed, what it cost, what we're doing next. Written by the person running your account.</p>
            </div>
          </li>
        </ul>
      </div>
      <div data-reveal>
        <ReportPanel />
        <p class="caption">Example report layout. Your numbers go here.</p>
      </div>
    </div>
  </section>

  <!-- Path -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head section-head--center">
        <h2>What happens after the <mark>click matters</mark>.</h2>
        <p class="lead">Good campaigns need a clear offer, useful replies, a booking handoff and feedback from the people answering the phone.</p>
      </div>
      <div class="path-art"><InlineIllo name="patient-path" /></div>
      <ol class="steps" role="list">
        {path.map((s) => (
          <li class="card" data-reveal>
            <span class="num">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.b}</p>
          </li>
        ))}
      </ol>
      <div class="center-link"><a class="link-arrow" href="/how-it-works/">How the first 90 days work <Icon name="arrow" class="i16" /></a></div>
    </div>
  </section>

  <!-- Results -->
  <section class="section section--mist">
    <div class="container">
      <div class="section-head section-head--split">
        <h2>Results from <mark>live accounts</mark>.</h2>
        <p class="lead">Campaign examples with the metric defined. A reply rate or form conversion is not the same as a booked or attended appointment.</p>
      </div>
      <div class="grid grid--2">
        {cases.map((c, i) => <CaseCard slug={c.id} data={c.data} dark={i === 0} />)}
      </div>
      <div class="results-foot">
        <p class="lead">Judge the numbers by what they measure. The examples above show lead response and ad conversion, not a claim that every lead became a paying patient.</p>
        <div class="btn-row">
          <a href="/case-studies/" class="btn btn--outline">See case studies</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <h2>Built around the realities of <mark>cash-pay healthcare</mark>.</h2>
        <p class="lead">
          Med spas are our core focus, especially injectables and skin services. We also work with longevity, wellness, telehealth and aesthetic practices where the patient journey differs from traditional insurance-based care.
        </p>
      </div>
      <div class="grid grid--4">
        {verticals.map((v) => (
          <a href={`/who-we-serve/${v.slug}/`} class="card card--link vcard" data-reveal>
            <h3>{v.name}</h3>
            <p>{v.short}</p>
            <span class="arrow"><Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="section dots-ink founder">
    <div class="container">
      <MedPlus size={88} flat class="f-plus" />
      <figure class="on-ink">
        <span class="qmark" aria-hidden="true">“</span>
        <blockquote>
          <FounderQuote client:visible text="We’d rather tell you we’re not a fit than take a retainer we can’t earn." markWords={[5, 7]} />
        </blockquote>
        <figcaption><strong>Nathan Smith</strong><span>Founder &amp; CEO, NexaMed</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- Platforms -->
  <section class="section section--white section--tight">
    <div class="container"><PlatformStrip /></div>
  </section>

  <!-- Learn -->
  <section class="section section--mist">
    <div class="container">
      <div class="section-head section-head--split">
        <h2>Practical answers from <mark>real account work</mark>.</h2>
        <div>
          <p class="lead">No recycled list of generic marketing tips. We write about landing-page intent, campaign tracking, intake, patient follow-up and ad policy.</p>
          <p style="margin-top:1rem"><a class="link-arrow" href="/learn/">Everything in Learn <Icon name="arrow" class="i16" /></a></p>
        </div>
      </div>
      <div class="grid grid--3">
        {posts.map((p) => <PostCard slug={p.id} data={p.data} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .proof-wrap {
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-bottom: var(--section-y);
  }

  .bento {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 760px) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
    .b-crm {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1100px) {
    .bento {
      grid-template-columns: 1.35fr 1fr 1fr;
      grid-template-rows: auto auto;
    }
    .b-crm {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
  }
  .bento .card {
    display: flex;
    flex-direction: column;
  }
  .b-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .b-sm {
    min-height: 260px;
  }
  .b-sm p {
    margin-top: auto;
    padding-top: 2.5rem;
  }
  .b-title-lg {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-top: 2rem;
    letter-spacing: 0;
  }
  .b-crm p {
    margin-top: 1rem;
    max-width: 40ch;
  }
  .b-art {
    margin-top: auto;
    padding-top: 2rem;
  }

  .feature-rows {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
  }
  .feature-rows li {
    display: flex;
    gap: 1.1rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--ink-line);
  }
  .feature-rows li:last-child {
    border-bottom: 1px solid var(--ink-line);
  }
  .feature-rows h3 {
    font-size: 1.3rem;
  }
  .feature-rows p {
    margin-top: 0.4rem;
    color: var(--on-ink-2);
  }
  .feature-rows .arrow {
    border-radius: 8px;
    width: 40px;
    height: 40px;
  }
  .fr-on {
    background: var(--azure);
    border-color: var(--azure);
    color: var(--white);
  }
  .caption {
    margin-top: 0.85rem;
    font-size: var(--fs-xs);
    color: var(--on-ink-2);
    text-align: center;
  }

  .path-art :global(img) {
    width: 100%;
  }
  .path-art {
    max-width: 1100px;
    margin-inline: auto;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .steps h3 {
    margin-top: 0.75rem;
    font-size: 1.25rem;
  }
  .center-link {
    text-align: center;
    margin-top: 2.5rem;
  }
  :global(.i16) {
    width: 16px;
    height: 16px;
  }

  .results-foot {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .results-foot {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
  }

  .vcard {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 240px;
  }
  .vcard .arrow {
    margin-top: auto;
  }

  .founder {
    color: var(--white);
    overflow: hidden;
  }
  .founder .container {
    position: relative;
  }
  .founder :global(.f-plus) {
    position: absolute;
    right: var(--gutter);
    top: -1rem;
  }
  .founder figure {
    margin: 0;
    max-width: 980px;
  }
  .qmark {
    display: block;
    font: 700 7rem/0.6 var(--font-head);
    color: var(--azure);
    height: 3.5rem;
  }
  .founder blockquote {
    margin: 1.5rem 0 0;
  }
  .founder blockquote :global(.fq) {
    font-family: var(--font-head);
    font-weight: 700;
    letter-spacing: 0;
    font-size: clamp(2.6rem, 1.6rem + 4vw, 5.5rem);
    line-height: 0.95;
    text-wrap: balance;
  }
  .founder figcaption {
    margin-top: 2.5rem;
  }
  .founder figcaption strong {
    display: block;
    font: 700 1.2rem/1.3 var(--font-head);
  }
  .founder figcaption span {
    color: var(--on-ink-2);
  }
  @media (max-width: 700px) {
    .founder :global(.f-plus) {
      display: none;
    }
  }
</style>
