---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CaseCard from "../../components/CaseCard.astro";
import Testimonial from "../../components/Testimonial.astro";
import { verticals } from "../../data/verticals";
import { services } from "../../data/services";

const cases = (await getCollection("caseStudies")).sort((a, b) => a.data.order - b.data.order);
const usedV = verticals.filter((v) => cases.some((c) => c.data.vertical === v.slug));
const usedS = services.filter((s) => cases.some((c) => c.data.services.includes(s.slug)));
---
<Base title="Results" description="Case studies from live NexaMed client accounts: Google Ads, Meta and CRM results for medspas and cash-pay clinics, with exactly what was counted.">
  <PageHero
    title="Results from [[live accounts]]."
    lead="Numbers from client accounts, shared with permission. Every case study says what was counted, what we changed, and how long it's held."
    crumbs={[{ label: "Results" }]}
    illo="owner-results"
  />
  <section class="section section--mist">
    <div class="container">
      <div class="filters" data-filters hidden>
        <fieldset>
          <legend>Practice type</legend>
          <div class="chips">
            <button type="button" class="chip" aria-pressed="true" data-fv="">All</button>
            {usedV.map((v) => <button type="button" class="chip" aria-pressed="false" data-fv={v.slug}>{v.name}</button>)}
          </div>
        </fieldset>
        <fieldset>
          <legend>Service</legend>
          <div class="chips">
            <button type="button" class="chip" aria-pressed="true" data-fs="">All</button>
            {usedS.map((s) => <button type="button" class="chip" aria-pressed="false" data-fs={s.slug}>{s.name}</button>)}
          </div>
        </fieldset>
      </div>
      <div class="grid grid--2" data-case-grid>
        {cases.map((c) => <CaseCard slug={c.id} data={c.data} />)}
      </div>
      <p class="empty" data-empty hidden>No case studies match that combination yet.</p>
      <p class="count" aria-live="polite" data-count></p>
    </div>
  </section>
  <section class="section section--white">
    <div class="container split">
      <div>
        <h2>How we report results</h2>
        <p class="lead" style="margin-top:1.25rem">
          We'd rather show a smaller number you can trust than a big one you can't. Conversion rates count calls and
          form fills unless we say otherwise. Booked and showed come from your CRM or EMR, not ad platform estimates.
        </p>
      </div>
      <Testimonial quote="[One-sentence quote about results, from Todd Smith or Dr. Houlis.]" name="Dr. Houlis" role="[Practice name]" />
    </div>
  </section>
</Base>
<script>
  const wrap = document.querySelector<HTMLElement>("[data-filters]");
  if (wrap) {
    wrap.hidden = false;
    let fv = "", fs = "";
    const cards = document.querySelectorAll<HTMLElement>("[data-case-grid] > *");
    const empty = document.querySelector<HTMLElement>("[data-empty]")!;
    const count = document.querySelector<HTMLElement>("[data-count]")!;
    const apply = () => {
      let n = 0;
      cards.forEach((c) => {
        const ok = (!fv || c.dataset.vertical === fv) && (!fs || (c.dataset.services ?? "").split(" ").includes(fs));
        c.hidden = !ok;
        if (ok) n++;
      });
      empty.hidden = n > 0;
      count.textContent = `${n} case ${n === 1 ? "study" : "studies"} shown`;
    };
    wrap.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("button.chip");
      if (!b) return;
      const group = b.closest(".chips")!;
      group.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      if (b.dataset.fv !== undefined) fv = b.dataset.fv;
      if (b.dataset.fs !== undefined) fs = b.dataset.fs;
      apply();
    });
  }
</script>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; margin-bottom: 2rem; }
  fieldset { border: 0; margin: 0; padding: 0; }
  legend { font-size: var(--fs-xs); font-weight: 600; color: var(--text-3); margin-bottom: 0.6rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    min-height: 40px; padding: 0.4rem 0.95rem; border-radius: 6px; border: 1.5px solid var(--steel);
    background: var(--white); font: 500 0.9rem/1 var(--font-body); color: var(--ink); cursor: pointer;
    transition: background-color 150ms var(--ease), border-color 150ms var(--ease), color 150ms var(--ease);
  }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--white); }
  .empty { margin-top: 1rem; color: var(--text-2); }
  .count { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
